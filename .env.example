# Neon: painel > Connection string (use a "pooled", com sslmode=require)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.neon.tech/neondb?sslmode=require"
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
# Quem se cadastrar com este e-mail vira administrador
ADMIN_EMAIL="voce@exemplo.com"

# Serviço Python do extrator (pasta extrator/). Local: http://localhost:8001
EXTRATOR_URL="http://127.0.0.1:8001"
EXTRATOR_KEY="troque-por-uma-chave"

# --- Dados públicos do site (aparecem em Contato, Privacidade e Termos) ---
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"
NEXT_PUBLIC_RESPONSAVEL="Seu nome ou razão social"
NEXT_PUBLIC_CONTATO_EMAIL="contato@seu-dominio.com.br"
NEXT_PUBLIC_CONTATO_CIDADE="Brasília, DF"
# WhatsApp com DDI + DDD, só números (deixe vazio para não mostrar o botão)
NEXT_PUBLIC_WHATSAPP=""
# Google Analytics 4 (G-XXXXXXXXXX). Vazio = sem analytics e sem aviso de cookies.
NEXT_PUBLIC_GA_ID=""
